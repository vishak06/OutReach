# Ethereal Email (auto-generated on first run, or set manually)
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
